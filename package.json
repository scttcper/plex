{
  "name": "@ctrl/plex",
  "version": "0.0.0-placeholder",
  "description": "Plex api client in typescript using ofetch",
  "keywords": [
    "plex",
    "typescript"
  ],
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scttcper/plex.git"
  },
  "files": [
    "dist/src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "typings": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt",
    "prepare": "pnpm run build",
    "build": "tsc",
    "build:docs": "pnpm --filter @ctrl/plex-typedoc exec typedoc --options ../../typedoc.json --tsconfig ../../tsconfig.json",
    "test": "vitest run",
    "bootstraptest": "node --env-file-if-exists=.env scripts/bootstraptest.ts --create-photos",
    "teardowntest": "node --env-file-if-exists=.env scripts/teardowntest.ts",
    "add-media": "node --env-file-if-exists=.env scripts/add-media.ts",
    "test-cleanup": "node --env-file-if-exists=.env scripts/test-cleanup.ts",
    "test:types": "tsc --project test/types/tsconfig.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "ofetch": "^1.5.1",
    "uint8array-extras": "^1.6.0"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.5.0",
    "@ctrl/video-filename-parser": "5.12.0",
    "@sindresorhus/tsconfig": "8.1.0",
    "@types/node": "26.6.5",
    "nanospinner": "1.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "p-retry": "8.0.1",
    "tinyexec": "1.3.1",
    "tinyglobby": "0.2.17",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
